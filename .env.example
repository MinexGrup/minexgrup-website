# ---------------------------------------------------------------------------
# Minex Grup — environment variables
# Copy this file to ".env.local" and fill in real values. NEVER commit secrets.
# ---------------------------------------------------------------------------

# --- Airtable (Parts Catalog, phase 2) -------------------------------------
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_PARTS_TABLE=Parts

# --- Email delivery for quote / contact submissions ------------------------
# Using Resend (https://resend.com) by default. Swap for SendGrid/Formspree if preferred.
RESEND_API_KEY=
# Internal recipients — quote/contact leads are delivered here (never shown on the site)
QUOTE_RECIPIENTS=siraj.t@minexgrup.com,j.talibov@minexgrup.com
# The "from" address the site sends as (must be a verified domain in your email service)
QUOTE_FROM=quotes@minexgrup.com
